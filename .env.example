# Copier ce fichier en .env et adapter si besoin.
# Ces valeurs correspondent aux defaults de terraform/local.tfvars.example (MinIO local).

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_password
S3_USE_PATH_STYLE=true

BUCKET_MAIN=app-data-main
BUCKET_BACKUP=app-data-backup
